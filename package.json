{
  "name": "@hecto/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "nx": "nx",
    "start:main": "nx run-many --target=serve -p manager,admin-app",
    "dev:backend": "nx run backend:serve",
    "dev:worker": "nx run backend:serve-worker",
    "dev:manager": "nx run @hecto/manager:serve",
    "dev:admin": "nx run admin-app:serve",

    "mobile": "pnpm --filter @hecto/employee start",
    "mobile:android": "pnpm --filter @hecto/employee android",
    "mobile:ios": "pnpm --filter @hecto/employee ios",
    "mobile:build:android": "pnpm --filter @hecto/employee build:android",
    "mobile:build:ios": "pnpm --filter @hecto/employee build:ios",

    "visitor": "pnpm --filter @hecto/visitor start",
    "visitor:android": "pnpm --filter @hecto/visitor android",
    "visitor:ios": "pnpm --filter @hecto/visitor ios",
    "visitor:build:android": "pnpm --filter @hecto/visitor build:android",
    "visitor:build:ios": "pnpm --filter @hecto/visitor build:ios",

    "build": "nx run-many --target=build",
    "build:backend": "nx run backend:build",
    "build:manager": "nx run @hecto/manager:build",
    "build:admin": "nx run @hecto/admin:build",

    "test": "nx run-many --target=test",
    "test:affected": "nx affected --target=test",

    "lint": "nx run-many --target=lint",
    "lint:fix": "nx run-many --target=lint -- --fix",
    "lint:affected": "nx affected --target=lint",

    "typecheck": "nx run-many --target=typecheck",
    "typecheck:affected": "nx affected --target=typecheck",

    "graph": "nx graph",
    "graph:affected": "nx affected:graph",

    "clean:cache": "nx reset",
    "clean:dist": "find . -name 'dist' -not -path '*/node_modules/*' -prune -exec rm -rf {} +",
    "clean:modules": "find . -name 'node_modules' -prune -exec rm -rf {} +",
    "clean": "pnpm clean:cache && pnpm clean:dist",
    "clean:all": "pnpm clean && pnpm clean:modules",

    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:backup": "sh libs/backend/database/scripts/backup.sh",
    "db:restore": "sh libs/backend/database/scripts/restore.sh",
    "db:revert": "SWC_NODE_PROJECT=apps/backend/tsconfig.runtime.json node --require @swc-node/register libs/backend/database/scripts/revert.ts",
    "db:check-drift": "sh libs/backend/database/scripts/check-drift.sh",
    "db:check-down-migrations": "node libs/backend/database/scripts/check-down-migrations.js",
    "seed": "SWC_NODE_PROJECT=apps/backend/tsconfig.runtime.json node --require @swc-node/register apps/backend/src/seed/seed.ts",
    "superadmin:create": "SWC_NODE_PROJECT=apps/backend/tsconfig.runtime.json node --require @swc-node/register apps/backend/src/seed/create-superadmin.ts"
  },
  "private": true,
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/devkit": "22.6.5",
    "@nx/eslint": "^22.6.5",
    "@nx/jest": "^22.6.5",
    "@nx/js": "22.6.5",
    "@nx/nest": "^22.6.5",
    "@nx/node": "22.6.5",
    "@nx/playwright": "22.6.5",
    "@nx/react": "22.6.5",
    "@nx/vite": "22.6.5",
    "@nx/vitest": "22.6.5",
    "@nx/web": "22.6.5",
    "@nx/webpack": "22.6.5",
    "@playwright/test": "^1.36.0",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.9",
    "@types/nodemailer": "^8.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "@vitest/coverage-v8": "~4.1.0",
    "@vitest/ui": "~4.1.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.76.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jest": "^30.3.0",
    "jest-environment-node": "^30.0.2",
    "jest-util": "^30.0.2",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "nodemailer": "^8.0.7",
    "nx": "22.6.5",
    "prettier": "^3.8.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.4.9",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vite-plugin-dts": "~4.5.0",
    "vitest": "~4.1.0",
    "webpack-cli": "^5.1.4"
  },
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@parcel/watcher",
      "@swc/core",
      "argon2",
      "esbuild",
      "less",
      "nx",
      "unrs-resolver"
    ],
    "patchedDependencies": {
      "react-native-css-interop@0.2.4": "patches/react-native-css-interop@0.2.4.patch"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.100.5",
    "@tanstack/react-query-devtools": "^5.100.5",
    "@tanstack/react-router": "^1.168.24",
    "axios": "^1.6.0",
    "clsx": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.74.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  }
}
