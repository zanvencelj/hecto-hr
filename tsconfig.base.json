{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@hecto/shared-types": ["./libs/shared/types/src/index.ts"],
      "@hecto/database": ["./libs/backend/database/src/index.ts"],
      "@hecto/users": ["./libs/backend/users/src/index.ts"],
      "@hecto/auth": ["./libs/backend/auth/src/index.ts"],
      "@hecto/mail": ["./libs/backend/mail/src/index.ts"],
      "@hecto/queue": ["./libs/backend/queue/src/index.ts"],
      "@hecto/storage": ["./libs/backend/storage/src/index.ts"],
      "@hecto/ui": ["./libs/shared/ui/src/index.ts"],
      "@hecto/api-client": ["./libs/shared/api-client/src/index.ts"],
      "@hecto/schemas": ["./libs/shared/schemas/src/index.ts"]
    }
  }
}
