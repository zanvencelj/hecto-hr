# App
NODE_ENV=development
PORT=3000
BACKEND_PORT=3000

# Database
DATABASE_URL=postgresql://hectohr:secret@localhost:5432/hectohr
POSTGRES_USER=hectohr
POSTGRES_PASSWORD=secret
POSTGRES_DB=hectohr
POSTGRES_PORT=5432

# JWT — use long random strings in production (min 32 chars each)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Email verification OTP — use a long random string in production (min 32 chars)
EMAIL_VERIFICATION_SECRET=change-me-otp-secret-at-least-32-characters-long

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# Redis (BullMQ queue backend)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=          # set in production
# REDIS_TLS=true           # set in production (e.g. Upstash, ElastiCache)

# SMTP (email sending)
# Docker Compose: SMTP_HOST is automatically set to the 'mailhog' service name — do NOT set it here
# Local dev without Docker: uncomment and set to localhost
# SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@hectohr.io
# SMTP_USER=               # not needed for Mailhog; set for production SMTP (e.g. SendGrid, SES)
# SMTP_PASS=               # not needed for Mailhog; set for production
# SMTP_SECURE=true         # set to true for port 465 (TLS); leave unset for 587/STARTTLS

# Mailhog ports (development only)
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# Frontend (Vite)
VITE_API_URL=http://localhost:3000
