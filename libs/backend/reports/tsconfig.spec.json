{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/jest",
    "rootDir": ".",
    "module": "commonjs",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "types": ["jest", "node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ],
  "references": [
    { "path": "./tsconfig.lib.json" }
  ]
}
