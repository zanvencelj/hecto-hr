# Production environment for docker-compose.prod.yml.
#
# Copy to .env.production on the VPS (NOT into this repo — it's gitignored,
# see .gitignore) and fill in the placeholders below.
#
#   cp .env.production.example .env.production
#   scripts/deploy/generate-secrets.sh .env.production   # fills in the [GENERATE] ones for you
#   # then edit .env.production by hand for the [SET ME] ones (SMTP, DNS-dependent domains)
#
# docker-compose.prod.yml reads this file via `docker compose --env-file`.
# See docs/deployment.md for the full walkthrough.

# ── Registry (used by docker-compose.prod.yml to know which image to pull) ────
# Must match what scripts/deploy/build-and-push.sh pushed to.
REGISTRY=ghcr.io/zanvencelj
IMAGE_TAG=latest

# ── Domains ─────────────────────────────────────────────────────────────────
# These four DNS A records must point at the VPS IP before first deploy —
# Caddy (the `web` service) won't get a certificate for a domain that doesn't
# resolve to this box yet:
#   hectohr.com, www.hectohr.com, app.hectohr.com, admin.hectohr.com, files.hectohr.com
APP_URL=https://app.hectohr.com
CORS_ORIGINS=https://app.hectohr.com,https://admin.hectohr.com
MINIO_PUBLIC_ENDPOINT=https://files.hectohr.com
# Let's Encrypt sends renewal/expiry notices here — any address you actually read.
CADDY_ACME_EMAIL=admin@hectohr.com

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=hectohr
POSTGRES_PASSWORD=[GENERATE]
POSTGRES_DB=hectohr

# ── JWT / OTP secrets (≥ 32 chars each) ────────────────────────────────────
JWT_ACCESS_SECRET=[GENERATE]
JWT_REFRESH_SECRET=[GENERATE]
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
EMAIL_VERIFICATION_SECRET=[GENERATE]

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=[GENERATE]
# REDIS_TLS=true          # only if you swap the bundled Redis for a managed one

# ── SMTP (email sending) — [SET ME]: a real provider, not Mailhog ─────────────
# e.g. SendGrid, Postmark, Amazon SES, Mailgun. Required — invite emails,
# password resets and shift-publish notifications all go through this.
SMTP_HOST=[SET ME]
SMTP_PORT=587
SMTP_USER=[SET ME]
SMTP_PASS=[SET ME]
# SMTP_SECURE=true        # set true if SMTP_PORT=465
SMTP_FROM=noreply@hectohr.com

# ── Object storage (MinIO, self-hosted on this VPS) ────────────────────────
MINIO_ACCESS_KEY=[GENERATE]
MINIO_SECRET_KEY=[GENERATE]
MINIO_BUCKET=hectohr
MINIO_CONSOLE_PORT=9001    # loopback-only — see docker-compose.prod.yml

# ── Backups ─────────────────────────────────────────────────────────────────
BACKUP_RETENTION=14
BACKUP_HOUR=3

# ── Monitoring (Grafana + Loki, loopback-only — see docker-compose.prod.yml) ──
GRAFANA_USER=admin
GRAFANA_PASSWORD=[GENERATE]
GRAFANA_ROOT_URL=http://localhost:3001
GRAFANA_PORT=3001
LOKI_PORT=3100

# ── Error tracking (optional — leave unset to no-op) ───────────────────────
# SENTRY_DSN=

# ── Demo/superadmin seed (optional — only used if you run the `seed` /
# `superadmin-create` one-off jobs, see docs/deployment.md) ────────────────
# SUPERADMIN_EMAIL=
# SUPERADMIN_PASSWORD=
